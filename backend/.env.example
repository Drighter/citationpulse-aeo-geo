# Backend Server Configuration
PORT=4000
JWT_SECRET=super-secret-aeo-geo-jwt-key-change-in-production-2026

# Firebase Admin SDK Configuration (Cloud Firestore & Firebase Auth)
FIREBASE_PROJECT_ID=
# Paste single-line JSON service account or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or connect to Firebase Local Emulator Suite:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Optional: Default LLM Provider Keys for AI-Powered GEO Rewrites
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Stripe Billing Keys (falls back to instant simulated checkout in dev mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
